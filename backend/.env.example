# AnswerStack Backend Configuration
# Copy to .env and fill in values

# Application
APP_NAME=AnswerStack
DEBUG=false
LOG_JSON=true

# Database
DATABASE_URL=sqlite+aiosqlite:///data/answerstack.db

# Server
HOST=0.0.0.0
PORT=8000

# Document processing
CHUNK_SIZE=2200
CHUNK_OVERLAP=250
MAX_UPLOAD_SIZE_MB=50
DOCUMENT_STORAGE_PATH=data/documents

# ChromaDB
CHROMADB_PATH=data/chromadb

# Speech
TTS_PROVIDER=piper
PIPER_MODEL_DIR=data/piper
PIPER_VOICE=en_US-lessac-medium
STT_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
KOKORO_BASE_URL=
KOKORO_VOICE=af_bella
