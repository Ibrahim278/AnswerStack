# AnswerStack Backend Configuration
# Copy to .env and fill in values

# Application
APP_NAME=AnswerStack
DEBUG=false
LOG_JSON=true

# Database
DATABASE_URL=sqlite+aiosqlite:///data/answerstack.db

# Server
HOST=0.0.0.0
PORT=8000

# Speech
TTS_PROVIDER=piper
PIPER_MODEL_DIR=data/piper
PIPER_VOICE=en_US-lessac-medium
STT_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
