# AnswerStack Backend Configuration
# Copy to .env and fill in values

# Application
APP_NAME=AnswerStack
DEBUG=false
LOG_JSON=true

# Database
DATABASE_URL=sqlite+aiosqlite:///data/answerstack.db

# Server
HOST=0.0.0.0
PORT=8000

# LLM Provider
PROVIDER_URL=
PROVIDER_API_KEY=
PROVIDER_MODEL=
EMBEDDING_MODEL=

# Document processing
CHUNK_SIZE=2200
CHUNK_OVERLAP=250
MAX_UPLOAD_SIZE_MB=50
DOCUMENT_STORAGE_PATH=data/documents

# ChromaDB
CHROMADB_PATH=data/chromadb

# Speech — TTS
TTS_PROVIDER=piper
PIPER_MODEL_DIR=data/piper
PIPER_VOICE=en_US-lessac-medium
KOKORO_BASE_URL=
KOKORO_VOICE=af_bella
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_TTS_VOICE_ID=

# Speech — STT
STT_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
